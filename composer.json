{
    "name": "ufsc/gestion-clubs-licences",
    "description": "Plugin WordPress UFSC de gestion des clubs, affiliations et licences.",
    "license": "proprietary",
    "require": {
        "phpoffice/phpspreadsheet": "^1.30"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
        "php-stubs/woocommerce-stubs": "^9.0 || ^10.0",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.13",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "wp-coding-standards/wpcs": "^3.2"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml",
        "test:standalone": "@php tests/run-standalone.php",
        "repro:p0": "@php tests/repro/run-p0.php",
        "analyse": "phpstan analyse -c phpstan.neon --no-progress --memory-limit=1G",
        "cs": "phpcs --standard=phpcs.xml.dist",
        "quality": [
            "@test:standalone",
            "@repro:p0",
            "@test",
            "@analyse",
            "@cs"
        ]
    }
}
