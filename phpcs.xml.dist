<?xml version="1.0"?>
<ruleset name="UFSC critical-domain WordPress quality">
    <description>Progressive blocking WPCS gate for security/database correctness on the licence, quota, season and WooCommerce flows. Historical formatting debt remains out of scope until the critical flow is stable.</description>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg value="sp"/>
    <config name="ignore_warnings_on_exit" value="1"/>

    <file>inc/common/licence-status.php</file>
    <file>inc/common/compliance.php</file>
    <file>inc/common/fighter-level.php</file>
    <file>inc/common/licence-finalization-runtime.php</file>
    <file>inc/woocommerce/cart-integration.php</file>
    <file>inc/woocommerce/hooks.php</file>
    <file>inc/woocommerce/settings-woocommerce.php</file>
    <file>includes/core/class-unified-handlers.php</file>
    <file>includes/core/class-ufsc-debug-trace.php</file>
    <file>includes/core/class-ufsc-licence-finalization-service.php</file>
    <file>includes/core/class-ufsc-licence-payments.php</file>
    <file>includes/core/class-ufsc-renewal-service.php</file>
    <file>includes/core/class-ufsc-season-service.php</file>
    <file>includes/front/class-ufsc-stats.php</file>

    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.DB"/>
    <rule ref="WordPress.WP.DeprecatedFunctions"/>

    <exclude-pattern>vendor/*</exclude-pattern>
</ruleset>
